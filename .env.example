# Copy this file to .env.local (already gitignored) and fill in real values.
# .env.local is only ever read by your local `npm run dev` — it never gets
# committed or deployed. Vercel's own Production/Preview env vars are managed
# separately in the Vercel dashboard and are what the live site actually uses.
#
# IMPORTANT: the values below should point at DEV/TEST resources, never the
# real production database or live Stripe keys, so local work can never touch
# real customer data or move real money.

# --- Database ---
# Use a different database name on the same Atlas cluster (e.g. swap
# `/yourshop` for `/yourshop_dev` at the end of the URI) rather than the
# live production URI. It's a separate, empty namespace on the same cluster —
# free, isolated, and nothing here can ever touch his real collections.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/yourshop_dev

# --- Auth ---
# Any random string works locally — sessions never need to cross between
# your machine and the real site. Generate one with: openssl rand -hex 64
JWT_SECRET=

# --- Admin bootstrap (only used by scripts/init-admin.js) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Stripe (TEST MODE keys only — toggle "Test mode" in the Stripe
# dashboard, then Developers > API keys. Test keys start with sk_test_/pk_test_
# and never move real money or touch real customer subscriptions.) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
FROM_EMAIL=noreply@example.com

# --- OneSignal (use a separate OneSignal "app" for dev so test
# notifications never reach real customers' devices) ---
# Server-only — used to call the OneSignal REST API (lib/onesignal.ts).
ONESIGNAL_API_KEY=
# App IDs aren't secret (same split as STRIPE_SECRET_KEY vs.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY) — this one is read both by the server
# helper and by the Web SDK mounted client-side in app/layout.tsx.
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Analytics (optional) ---
# app/layout.tsx only mounts the gtag script when this is set — leave it
# blank locally, add the real GA4 measurement ID (G-XXXXXXX) in production
# once the client wants analytics turned on.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Cron auth ---
# Vercel automatically sends this as a Bearer token on its own scheduled
# invocations (see vercel.json "crons"). The route fails closed (500) if
# this is unset in any environment, including local dev — set it to any
# value here and pass the same value as `Authorization: Bearer <value>`
# when curling the route by hand to test it.
CRON_SECRET=
